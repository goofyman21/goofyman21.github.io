# Quote source: yahoo (default, no key), finnhub, or alphavantage.
# Keys are read only by the server route. Do not prefix them with NEXT_PUBLIC_.
PRICE_PROVIDER=yahoo

# Required only when PRICE_PROVIDER=finnhub.
# https://finnhub.io/register
FINNHUB_API_KEY=

# Required only when PRICE_PROVIDER=alphavantage.
# The free tier is heavily rate limited, so Meridian caches it for 12 hours
# unless QUOTE_CACHE_SECONDS is set. https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Optional server-side cache lifetime in seconds.
# Defaults: yahoo and finnhub 20 seconds, alphavantage 43200 seconds (12 hours).
QUOTE_CACHE_SECONDS=

# How often the open app asks the server for prices, in seconds.
# Values are clamped to the 30–60 second range. Default 45.
NEXT_PUBLIC_REFRESH_SECONDS=45
